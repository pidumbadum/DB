-- последовательности для всех измерений
create sequence seq_dim_ranges;
create sequence seq_dim_products;
create sequence seq_dim_operation_types;
create sequence seq_dim_transaction_types;
create sequence seq_dim_price_groups;
create sequence seq_dim_document_types;
create sequence seq_dim_journal_types;
create sequence seq_dim_vendors;
create sequence seq_dim_vendor_groups;
create sequence seq_dim_personnel;
create sequence seq_dim_storages;
create sequence seq_dim_time;
create sequence seq_dim_categories;
create sequence seq_dim_prices;
create sequence seq_dim_recipes;

-- единицы измерения (из примера преподавателя)
create table dim_ranges (
    id bigint primary key default nextval('seq_dim_ranges'),
    external_id bigint,
    name text,
    factor float,
    date_add timestamp default now()
);

-- номенклатура
create table dim_products (
    id bigint primary key default nextval('seq_dim_products'),
    external_id bigint,
    name text,
    vendor_id bigint,
    category_id bigint,
    subcategory_id bigint,
    base_cost numeric(18,3),
    date_add timestamp default now()
);

-- категории (новое)
create table dim_categories (
    id bigint primary key default nextval('seq_dim_categories'),
    external_id bigint,
    name text,
    parent_id bigint,
    date_add timestamp default now()
);

-- типы операций хранения
create table dim_operation_types (
    id bigint primary key default nextval('seq_dim_operation_types'),
    external_id bigint,
    name text,
    factor int,
    date_add timestamp default now()
);

-- типы транзакций
create table dim_transaction_types (
    id bigint primary key default nextval('seq_dim_transaction_types'),
    external_id bigint,
    group_id int,
    preview_group_type text,
    name text,
    date_add timestamp default now()
);

-- группы цен
create table dim_price_groups (
    id bigint primary key default nextval('seq_dim_price_groups'),
    external_id bigint,
    name text,
    date_start timestamp,
    date_add timestamp default now()
);

-- актуальные цены (новое)
create table dim_prices (
    id bigint primary key default nextval('seq_dim_prices'),
    external_id bigint,
    product_id bigint,
    price_group_id bigint,
    price numeric(18,3),
    date_add timestamp default now()
);

-- типы документов
create table dim_document_types (
    id bigint primary key default nextval('seq_dim_document_types'),
    external_id bigint,
    name text,
    date_add timestamp default now()
);

-- типы журналов
create table dim_journal_types (
    id bigint primary key default nextval('seq_dim_journal_types'),
    external_id bigint,
    name text,
    date_add timestamp default now()
);

-- поставщики
create table dim_vendors (
    id bigint primary key default nextval('seq_dim_vendors'),
    external_id bigint,
    name text,
    inn text,
    kpp text,
    ogrn text,
    group_id bigint,
    date_add timestamp default now()
);

-- группы поставщиков
create table dim_vendor_groups (
    id bigint primary key default nextval('seq_dim_vendor_groups'),
    external_id bigint,
    name text,
    date_add timestamp default now()
);

-- персонал
create table dim_personnel (
    id bigint primary key default nextval('seq_dim_personnel'),
    external_id bigint,
    last_name text,
    first_name text,
    middle_name text,
    full_name text,
    security_access int,
    flag_pos smallint,
    flag_reports smallint,
    date_add timestamp default now()
);

-- склады
create table dim_storages (
    id bigint primary key default nextval('seq_dim_storages'),
    external_id bigint,
    name text,
    date_add timestamp default now()
);

-- время
create table dim_time (
    id bigint primary key default nextval('seq_dim_time'),
    date_start_month date,
    date_end_month date,
    month_name text,
    year int,
    quarter_number int,
    quarter_name text,
    date_add timestamp default now()
);

-- рецептуры
create table dim_recipes (
    id bigint primary key default nextval('seq_dim_recipes'),
    external_id bigint,
    recipe_product_id bigint,
    ingredient_product_id bigint,
    size_id bigint,
    portion numeric(18,3),
    cooking_loss numeric(18,3),
    date_add timestamp default now()
);