-- ТРАНЗАКЦИЯ 3.СОздание связей между таблицами и ограничений
-----------------------------------------------

	-- ALTER TABLE public.params_types DROP CONSTRAINT fk_param_unit;

	-- params_types -> units_measurement
	alter table public.params_types 
		add constraint fk_param_unit
		foreign key (id_units_measurement)
		references public.units_measurement(id);
	
	-- measurment_input_params -. params_types (параметр имеет тип)
	alter table public.measurment_input_params 
		add constraint fk_input_pt
		foreign key (id_param_type)
		references public.params_types(id);

	-- employee -> positions (сотрудник имеет должность)
	alter table public.employee 
		add constraint fk_employee_position
		foreign key (military_rank_id)
		references public.positions(position_id);
	
	-- logs -> employee (пачка проведена сотрудником)
	alter table public.logs 
		add constraint fk_log_employee
		foreign key (user_id)
		references public.employee(id);
	
	-- logs -> equipment_types (пачка проведена на оборудовании)
	alter table public.logs 
		add constraint fk_log_equipment
		foreign key (equipment_type_id)
		references public.equipment_types(equipment_id);
	
	-- measurment_input_params -> logs (параметр принадлежит пачке)
	alter table public.measurment_input_params 
		add constraint fk_param_log
		foreign key (measurment_bath_id)
		references public.logs(id);

	-- ОГРАНИЧЕНИЯ
	----------------------------------
	
	-- Значение параметра не может быть слишком экстремальным
	alter table public.measurment_input_params 
		add constraint chk_param_value
		check (param_value between -100 and 10000);
	
	-- Название должности не должно быть пустым
	alter table public.positions 
		add constraint chk_position_name
		check (position_name is not null and length(position_name) > 0);
	
	-- ФИО сотрудника не должно быть пустым
	alter table public.employee 
		add constraint chk_employee_name
		check (name is not null and length(name) > 0);
	
	-- Допуски отклонений оборудования не могут быть отрицательными
	alter table public.equipment_types 
		add constraint chk_deviations_positive
		check (
			temperture_devation >= 0 
			and pressure_devation >= 0 
			and wind_direction_devation >= 0 
			and wind_speed_devation >= 0 
			and bullet_drift_dist_devation >= 0
		);
		
