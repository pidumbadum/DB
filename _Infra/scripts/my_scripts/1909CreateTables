-- SELECT с объединением всех таблиц
SELECT *
FROM batches AS b
    JOIN users AS u ON u.user_id = b.user_id
    JOIN positions AS pos ON pos.position_id = u.position_id
    JOIN equipment_types AS et ON et.equipment_id = b.equipment_id
    JOIN parameters AS prm ON prm.parameter_id = b.parameter_id