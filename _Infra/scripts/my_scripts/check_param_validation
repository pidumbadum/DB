	-- СОЗДАНИЕ ФУНКЦИИ проверки единственного параметра
	begin
	create function check_single_rule(
	    p_value numeric,
	    p_rule text
	)
	returns boolean as $func$
	declare
	    v_result boolean;
	begin
	    execute 'select (' || p_rule || ')'
	    using p_value
	    into v_result;
	    return v_result;
	end;
	$func$ language plpgsql;
	end;
	commit;

	--СОЗДАНИЕ ФУНКЦИИ проверки параметров
	-----------------
	begin
	create function find_val_errors(log_id int) 
	returns text as $func$
	declare
	    res_string text;
	begin
	    select string_agg(et.description || ' - ' || pt.param_name, e'\n')
	    into res_string
	    from measurment_input_params mip
	    join validation_rules vr on mip.id_param_type = any(vr.id_param)
	    join error_types et on et.id = vr.id_error
	    join params_types pt on pt.id = mip.id_param_type
	    where mip.measurment_bath_id = log_id and not check_single_rule(mip.param_value, vr.val_rule)
	    group by mip.measurment_bath_id;
	    
	    return res_string;
	end;
	$func$ language plpgsql;
	end;
	commit;

	
	
end $do_block$;