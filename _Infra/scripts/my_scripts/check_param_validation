	(4, 'val * 10 = trunc(val * 10)', 1, array[2]),
	(5, 'val between 500 and 900', 2, array[3]),
	(6, 'val between 0 and 59', 2, array[4]),
	(7, 'val between 0 and 15', 2, array[5]),
	(8, 'val between 0 and 150', 2, array[6]);

