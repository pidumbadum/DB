 --    height_val numeric,
 --    temp_val numeric,
 --    pressure_val numeric,
 --    wind_dir_val numeric,
 --    wind_speed_val numeric,
 --    drift_val numeric
	-- );
	
	-- СОЗДАНИЕ ФУНКЦИИ ДЛЯ ПРОВЕРКИ ПРАВИЛЬНОСТИ ВВЕДЕНЫХ ПРАМАМЕТРОВ
	begin
		execute $create_func$
			create function find_val_errors(log_id int) 
			returns text as $func$
			declare 
				res_string text:=e'';
				val_row record;
				val_rule_error record;
				is_valid bool;
				error_description varchar(255);
				wrong_param_name char(100);
				
			begin
				--первый цикл - получаю параметры из пачек
				for val_row 
				in select id_param_type, param_value 
				from measurment_input_params where measurment_bath_id = log_id loop
					-- raise notice '%', val_row;
					-- второй цикл - поиск правил  в таблице public.validation_rules и проверка значений 
					for val_rule_error 
					in select val_rule, id_error from validation_rules 
					where val_row.id_param_type = any(id_param) loop
						--проверка самого значения
						execute 'select(' || val_rule_error.val_rule || ')'
						using val_row.param_value
						into is_valid;

						-- Записываю ошибку только если значние false
						if not is_valid then 
						
							select description into error_description from error_types
							where id = val_rule_error.id_error;

							select param_name into wrong_param_name from params_types
							where id = val_row.id_param_type;
							
							res_string := res_string ||error_description || e' - ' || wrong_param_name || e'\n';
						end if;
						
					end loop;
				end loop;
				return res_string;
			end;
			$func$ language plpgsql;
		$create_func$;
	end;
	commit;

	
	
end $do_block$;