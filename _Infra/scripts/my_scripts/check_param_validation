do $do_block$
begin 
	begin
	-- ОЧИСТКА ДЛЯ ПОВТОРНОГО ЗАПУСКА КОДА
	drop table if exists error_types cascade; 
	drop table if exists validation_rules; 
	drop function if exists find_val_errors;

 	-- СОЗДАНИЕ ТАБЛИЦЫ СО СПИСКОМ ОШИБОК
	create table if not exists error_types
	(
		id int primary key,
		description varchar(255)
	);
	
	insert into error_types values
	(1, 'Ошибка валидации: система принимает дробное число в поле ввода целых чисел'),
	(2, 'Ошибка: выход за пределы допустимого значения'),
	(3, 'Ошибка валидации: система допускает дробное только числа с меньшим/большим кол-вом знаков после запятой');

	--ТАБЛИЦА ДЛЯ ПРОВЕРКИ ВАЛИДНОСТИ ПАРАМЕТРОВ 
	create table if not exists validation_rules
	(
		id int primary key,
		val_rule varchar(255), 
		id_error int,
		foreign key(id_error) references error_types(id),
		id_param int[]
	);

	insert into validation_rules(id, val_rule, id_error, id_param) values
	(1, '$1 = trunc($1)', 1, array[1,3,4,5,6]),
	(2, '$1 between -500 and 10000', 2, array[1]),
	(3, '$1 between -58 and 58', 2, array[2]),
	(4, '$1 * 10 = trunc($1 * 10)', 1, array[2]),
	(5, '$1 between 500 and 900', 2, array[3]),
	(6, '$1 between 0 and 59', 2, array[4]),
	(7, '$1 between 0 and 15', 2, array[5]),
	(8, '$1 between 0 and 150', 2, array[6]);

	-- Комментарии к таблице error_types
	comment on table error_types is 'Справочник типов ошибок валидации параметров';
	comment on column error_types.id is 'Уникальный идентификатор типа ошибки';
	comment on column error_types.description is 'Текстовое описание типа ошибки';
	
	-- Комментарии к таблице validation_rules
	comment on table validation_rules is 'Правила валидации параметров с указанием применимых параметров и типов ошибок';
	comment on column validation_rules.id is 'Уникальный идентификатор правила валидации';
	comment on column validation_rules.val_rule is 'SQL-выражение для проверки значения параметра (использует плейсхолдер val)';
	comment on column validation_rules.id_error is 'Ссылка на тип ошибки в таблице error_types';
	comment on column validation_rules.id_param is 'Массив идентификаторов параметров из params_types, к которым применяется данное правило';

	end;
	commit;
	--СОЗДАНИЕ ТИПА ДАННЫХ ДЛЯ ХРАНЕНИЯ СПИСКА ПАРАМЕТРОВ 
	-- Дданные: высота, темпераутра, давление, направление ветра, скорость ветра, дальность сноса пуль 
	-- создаются ДВА типа данных 
